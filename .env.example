# Application Environment
SPRING_PROFILES_ACTIVE=dev
SHOW_SQL=false
HIBERNATE_DDL_AUTO=validate

# Database Configuration Example
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sam_db
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_POOL_MAX=20
DB_POOL_MIN=5

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# Docker Compose Ports
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8080

# JWT Configuration Example
JWT_SIGNER_KEY_BASE64=your_base64_64_byte_secret_key_here
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800
JWT_ISSUER=sam-be
JWT_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://sam.pro.vn

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Swagger UI Authentication (set SWAGGER_AUTH_ENABLED=true to enable Basic Auth)
SWAGGER_AUTH_ENABLED=true
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=your_swagger_password_here


# All payment collections use Pay2S. Start with SANDBOX; never label demo keys LIVE.
# Pause only new provider calls; existing IPN and fulfillment keep running.
PAYMENTS_CREATION_ENABLED=true
PAYMENTS_CREATION_DELAY_MS=1000
PAYMENTS_IPN_RETRY_DELAY_MS=2000
PAYMENTS_MONITOR_DELAY_MS=30000
PAYMENTS_PROVIDER=pay2s
PAYMENTS_ENVIRONMENT=SANDBOX
PAYMENTS_RETURN_URL=http://localhost:5173/payment/return
PAYMENTS_ALLOWED_RETURN_ORIGINS=http://localhost:5173,https://sam.pro.vn
PAY2S_BASE_URL=https://payment.pay2s.vn
PAY2S_PARTNER_CODE=
PAY2S_ACCESS_KEY=
PAY2S_SECRET_KEY=
PAY2S_BANK_CODE=ACB
PAY2S_BANK_ACCOUNT=
PAY2S_IPN_URL=https://YOUR-BACKEND/api/v1/payments/pay2s-ipn

# AES-256-GCM: independent random 32-byte keys, Base64. Never use JWT or Pay2S keys here.
# Ring syntax: v1:BASE64_KEY,v2:BASE64_KEY. Keep old keys to decrypt existing records.
FINANCE_BANK_ACTIVE_KEY=v1
FINANCE_BANK_KEYS=
FINANCE_BANK_FINGERPRINT_KEY=
# Enable only after live receipt, migration, beneficiary verification and operations review.
FINANCE_LIVE_PAYOUTS_ENABLED=false
# Requires different admins to approve and execute live manual payment.
FINANCE_DUAL_CONTROL=true
FINANCE_MINIMUM_WITHDRAWAL=50000
FINANCE_DAILY_WITHDRAWAL_LIMIT=100000000
