# Application Environment
SPRING_PROFILES_ACTIVE=dev
SHOW_SQL=false
HIBERNATE_DDL_AUTO=validate

# Database Configuration Example
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sam_db
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_POOL_MAX=20
DB_POOL_MIN=5

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# Docker Compose Ports
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8080

# JWT Configuration Example
JWT_SIGNER_KEY_BASE64=your_base64_64_byte_secret_key_here
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800
JWT_ISSUER=sam-be
JWT_COOKIE_SECURE=false

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Swagger UI Authentication (set SWAGGER_AUTH_ENABLED=true to enable Basic Auth)
SWAGGER_AUTH_ENABLED=true
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=your_swagger_password_here

# VNPay Sandbox Configuration (IPN + tạo URL thanh toán)
VNPAY_TMN_CODE=your_tmn_code_here
VNPAY_HASH_SECRET=your_hash_secret_here
VNPAY_API_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:5173/client/payment/vnpay-return
VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay-ipn
VNPAY_DEFAULT_CLIENT_IP=127.0.0.1
